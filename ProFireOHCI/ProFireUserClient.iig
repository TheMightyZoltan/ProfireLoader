//
//  ProFireUserClient.iig
//  Control-panel access to the ProFire's DICE register space.
//
//  Selectors:
//    0 info:  -> scalars [diceFound, node, rate, streaming, locked, numTx, numRx]
//    1 read:  scalars [addrLo, bytes<=4096] -> structure (bytes, bus order)
//    2 write: scalars [addrLo], structure (bus order, multiple of 4)
//    3 eap:   scalars [opcode] -> scalars [ok]
//  Addresses are the low 32 bits of the 0xFFFF'xxxx'xxxx DICE private space.
//

#ifndef ProFireUserClient_h
#define ProFireUserClient_h

#include <DriverKit/IOUserClient.iig>

class ProFireUserClient: public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;
    virtual kern_return_t ExternalMethod(uint64_t selector,
                                         IOUserClientMethodArguments * arguments,
                                         const IOUserClientMethodDispatch * dispatch,
                                         OSObject * target,
                                         void * reference) override;
};

#endif /* ProFireUserClient_h */
