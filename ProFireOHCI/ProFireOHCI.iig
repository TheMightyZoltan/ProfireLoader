//
//  ProFireOHCI.iig
//  M-Audio ProFire 2626 (TCAT DICE) over an OHCI 1394 controller, as an
//  AudioDriverKit sound card.
//

#ifndef ProFireOHCI_h
#define ProFireOHCI_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>
#include <AudioDriverKit/IOUserAudioDriver.iig>

class ProFireOHCI: public IOUserAudioDriver
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    // Developer commands: {"ProFireCommand": "restart" | "tone" | "stop" | "dump"}
    virtual kern_return_t SetProperties(OSDictionary * properties) override;

    // Developer commands via IOServiceOpen(type = 0xFE000000 | cmd << 16 | arg); other types go to Core Audio.
    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient ** userClient) override;

    // Bus resets, device discovery, notifications (default queue).
    virtual void HousekeepingFired(OSAction * action, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);
    // Isochronous packet pump (IO queue, ~1 ms).
    virtual void PumpFired(OSAction * action, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred) QUEUENAME(IO);

    // Called by ProFireAudioDevice.
    kern_return_t StartStreaming() LOCALONLY;
    kern_return_t StopStreaming() LOCALONLY;
    kern_return_t ChangeRate(double rate) LOCALONLY;

    // Called by ProFireUserClient (control panel).
    void ControlInfo(uint64_t * info, uint32_t count) LOCALONLY;
    kern_return_t ControlRead(uint32_t lo, uint8_t * buf, uint32_t bytes) LOCALONLY;
    kern_return_t ControlWrite(uint32_t lo, const uint8_t * buf, uint32_t bytes) LOCALONLY;
    bool ControlEAP(uint32_t opcode) LOCALONLY;
};

#endif /* ProFireOHCI_h */
