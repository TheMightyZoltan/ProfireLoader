//
//  ProFireOHCI.iig
//  Stage 1 test driver: takes over an OHCI 1394 controller (LSI FW643 in the
//  Belkin Thunderbolt Express Dock), brings the FireWire bus up, and reads the
//  config ROM of every other node. Results go to the unified log.
//

#ifndef ProFireOHCI_h
#define ProFireOHCI_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOTimerDispatchSource.iig>

class ProFireOHCI: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    // Polling tick: no interrupts are used in this stage.
    virtual void TimerFired(OSAction * action, uint64_t time) TYPE(IOTimerDispatchSource::TimerOccurred);
};

#endif /* ProFireOHCI_h */
